# ==============================================================================
# Server Configuration (Backend)
# ==============================================================================
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Example for local: mongodb://127.0.0.1:27017/rohit_portfolio
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rohit_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rohit_portfolio

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Optional Rate Limiting Overrides
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Optional Email Alerts (Nodemailer - leave blank if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# ==============================================================================
# Client Configuration (Frontend)
# ==============================================================================
# Set in client/.env.local (or Vercel Frontend Project Environment Variables)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
